# Required for production SEO: set to your verified HTTPS origin, no trailing slash.
# This example domain is a placeholder; ownership has not been verified.
NEXT_PUBLIC_SITE_URL=https://ayebcreative.com

# Optional: verified profile URLs activate footer and contact links. Rebuild after changes.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Optional server-side inquiry integration. Leave blank to prepare email drafts.
# HTTPS endpoint accepting the Inquiry JSON and returning { "received": true }
# ONLY after accepting the inquiry. Provider APIs may need an adapter; see README.
INQUIRY_ENDPOINT=
# Server-only bearer token, required only if your chosen endpoint requires it.
INQUIRY_API_KEY=
